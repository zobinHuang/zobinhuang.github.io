        <mxCell id="EskagqmwjSWaI6Iy32iG-60" value="&lt;font data-font-src=&quot;https://fonts.googleapis.com/css?family=Source+Code+Pro&quot; face=&quot;Source Code Pro&quot;&gt;&lt;b&gt;kernel&lt;/b&gt;(float* a){&lt;/font&gt;&lt;div&gt;&lt;font data-font-src=&quot;https://fonts.googleapis.com/css?family=Source+Code+Pro&quot; face=&quot;Source Code Pro&quot;&gt;&lt;span style=&quot;background-color: rgb(255, 224, 224);&quot;&gt;&amp;nbsp; a[0] =&amp;nbsp;tid&lt;/span&gt;&lt;br&gt;&lt;/font&gt;&lt;div&gt;&lt;font data-font-src=&quot;https://fonts.googleapis.com/css?family=Source+Code+Pro&quot; face=&quot;Source Code Pro&quot;&gt;}&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;strokeColor=none;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="-180" y="868" width="211" height="50" as="geometry" />
        </mxCell>
        <mxCell id="EskagqmwjSWaI6Iy32iG-61" value="&lt;b&gt;kernel&lt;/b&gt;(float* a, float* b){&lt;div&gt;&amp;nbsp; gid = tid + bid * bdim&lt;br&gt;&lt;div&gt;&amp;nbsp; if(tid&amp;nbsp;% 2 == 0)&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: rgb(255, 224, 224);&quot;&gt;&amp;nbsp; &amp;nbsp; b[gid] = a[0]&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;&amp;nbsp; else&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: rgb(255, 224, 224);&quot;&gt;&amp;nbsp; &amp;nbsp; a[0] = 3&lt;/span&gt;&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;strokeColor=none;fontFamily=Source Code Pro;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DSource%2BCode%2BPro;" vertex="1" parent="1">
          <mxGeometry x="-180" y="950" width="211" height="104" as="geometry" />
        </mxCell>
        <mxCell id="EskagqmwjSWaI6Iy32iG-62" value="&lt;b&gt;kernel&lt;/b&gt;(float* a){&lt;div&gt;&lt;div&gt;&lt;span style=&quot;background-color: rgb(255, 224, 224);&quot;&gt;&amp;nbsp; a[id] = 3&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; if(tid == 31)&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: rgb(255, 224, 224);&quot;&gt;&amp;nbsp; &amp;nbsp; a[id] = a[id] * a[id+1]&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;}&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;strokeColor=none;fontFamily=Source Code Pro;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DSource%2BCode%2BPro;" vertex="1" parent="1">
          <mxGeometry x="-180" y="1086" width="211" height="78" as="geometry" />
        </mxCell>
